{
  "id": "tokyo-ghoul-unofficial",
  "title": "Tokyo Ghoul: Unofficial TTRPG",
  "description": "A free, unofficial Tokyo Ghoul tabletop RPG system for Foundry VTT v14. This package contains original implementation code and no official Tokyo Ghoul artwork, panels, music, or logos.",
  "version": "0.4.0",
  "background": "systems/tokyo-ghoul-unofficial/assets/tokyo-ghoul-background.png",
  "media": [
    {
      "type": "setup",
      "url": "https://raw.githubusercontent.com/PrevotYann/tokyo-ghoul-unofficial-foundry/v0.4.0/assets/tokyo-ghoul-background.png",
      "thumbnail": "https://raw.githubusercontent.com/PrevotYann/tokyo-ghoul-unofficial-foundry/v0.4.0/assets/tokyo-ghoul-background.png"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14.368"
  },
  "authors": [
    {
      "name": "Tokyo Ghoul: Unofficial TTRPG community"
    }
  ],
  "esmodules": [
    "src/tokyo-ghoul.mjs"
  ],
  "styles": [
    "styles/tokyo-ghoul.css",
    "styles/sheets.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "fr",
      "name": "Francais",
      "path": "lang/fr.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": [
          "biography.appearance",
          "biography.personality",
          "biography.backstory",
          "biography.likes",
          "biography.dislikes",
          "biography.goals",
          "automation.ruleNotes"
        ]
      },
      "npc": {
        "htmlFields": [
          "biography.appearance",
          "biography.personality",
          "biography.backstory",
          "automation.ruleNotes"
        ]
      }
    },
    "Item": {
      "kagune": {
        "htmlFields": [
          "description",
          "dynamicNotes"
        ]
      },
      "quinque": {
        "htmlFields": [
          "description"
        ]
      },
      "edge": {
        "htmlFields": [
          "notes"
        ]
      },
      "gimmick": {
        "htmlFields": [
          "dynamicEffect"
        ]
      },
      "maneuver": {},
      "consumable": {},
      "kakuhou": {},
      "kakuja-armor": {
        "htmlFields": [
          "description"
        ]
      },
      "condition": {},
      "loot": {
        "htmlFields": [
          "description"
        ]
      }
    }
  },
  "packs": [
    {
      "name": "last-delivery",
      "label": "The Last Delivery • One-Shot",
      "path": "packs/last-delivery",
      "type": "Adventure",
      "system": "tokyo-ghoul-unofficial"
    },
    {
      "name": "edges",
      "label": "Edges",
      "path": "packs/edges",
      "type": "Item",
      "system": "tokyo-ghoul-unofficial"
    },
    {
      "name": "maneuvers",
      "label": "Maneuvers",
      "path": "packs/maneuvers",
      "type": "Item",
      "system": "tokyo-ghoul-unofficial"
    },
    {
      "name": "conditions",
      "label": "Conditions",
      "path": "packs/conditions",
      "type": "Item",
      "system": "tokyo-ghoul-unofficial"
    },
    {
      "name": "equipment",
      "label": "Equipment",
      "path": "packs/equipment",
      "type": "Item",
      "system": "tokyo-ghoul-unofficial"
    },
    {
      "name": "sample-kagune",
      "label": "Sample Kagune",
      "path": "packs/sample-kagune",
      "type": "Item",
      "system": "tokyo-ghoul-unofficial"
    },
    {
      "name": "sample-quinque",
      "label": "Sample Quinque",
      "path": "packs/sample-quinque",
      "type": "Item",
      "system": "tokyo-ghoul-unofficial"
    }
  ],
  "initiative": "@stats.spd.total",
  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "primaryTokenAttribute": "resources.vitality",
  "secondaryTokenAttribute": "resources.stamina",
  "packFolders": [
    {
      "name": "Tokyo Ghoul - Adventures",
      "sorting": "a",
      "packs": ["last-delivery"]
    },
    {
      "name": "Tokyo Ghoul - Rules",
      "sorting": "a",
      "packs": [
        "edges",
        "maneuvers",
        "conditions"
      ]
    },
    {
      "name": "Tokyo Ghoul - Arsenal",
      "sorting": "a",
      "packs": [
        "equipment",
        "sample-kagune",
        "sample-quinque"
      ]
    }
  ],
  "url": "https://github.com/PrevotYann/tokyo-ghoul-unofficial-foundry",
  "manifest": "https://github.com/PrevotYann/tokyo-ghoul-unofficial-foundry/releases/latest/download/system.json",
  "download": "https://github.com/PrevotYann/tokyo-ghoul-unofficial-foundry/releases/download/v0.4.0/tokyo-ghoul-unofficial.zip"
}
