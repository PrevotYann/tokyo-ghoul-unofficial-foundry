<form class="tg-form tg-item" autocomplete="off">
  <header class="tg-sheet-header">
    <img class="tg-portrait" src="{{item.img}}" alt="{{item.name}}" data-edit="img">
    <div class="tg-header-main">
      <input class="tg-name" name="name" type="text" value="{{item.name}}" aria-label="{{localize 'TG.sheet.name'}}">
      <div class="tg-chip-row">
        <span class="tg-chip">{{localize (concat "TG.itemTypes." item.type)}}</span>
        <span class="tg-chip">{{localize (concat "TG.automation." system.automation)}}</span>
      </div>
    </div>
  </header>

  <section class="tg-panel">
    <h2>{{localize 'TG.sheet.coreFields'}}</h2>
    <div class="tg-grid tg-grid-2">
      {{#if system.rcl}}
        <label>
          <span>{{localize 'TG.resources.rcl.label'}}</span>
          <input name="system.rcl" type="number" value="{{system.rcl}}" min="0" step="1">
        </label>
      {{/if}}
      {{#if system.primaryType}}
        <label>
          <span>{{localize 'TG.sheet.type'}}</span>
          <select name="system.primaryType">
            <option value="ukaku" {{#if (eq system.primaryType "ukaku")}}selected{{/if}}>{{localize 'TG.kagune.ukaku'}}</option>
            <option value="koukaku" {{#if (eq system.primaryType "koukaku")}}selected{{/if}}>{{localize 'TG.kagune.koukaku'}}</option>
            <option value="rinkaku" {{#if (eq system.primaryType "rinkaku")}}selected{{/if}}>{{localize 'TG.kagune.rinkaku'}}</option>
            <option value="bikaku" {{#if (eq system.primaryType "bikaku")}}selected{{/if}}>{{localize 'TG.kagune.bikaku'}}</option>
          </select>
        </label>
      {{/if}}
      {{#if system.quantity}}
        <label>
          <span>{{localize 'TG.sheet.quantity'}}</span>
          <input name="system.quantity" type="number" value="{{system.quantity}}" min="0" step="1">
        </label>
      {{/if}}
      <label>
        <span>{{localize 'TG.sheet.automation'}}</span>
        <select name="system.automation">
          <option value="full" {{#if (eq system.automation "full")}}selected{{/if}}>{{localize 'TG.automation.full'}}</option>
          <option value="assisted" {{#if (eq system.automation "assisted")}}selected{{/if}}>{{localize 'TG.automation.assisted'}}</option>
          <option value="manual" {{#if (eq system.automation "manual")}}selected{{/if}}>{{localize 'TG.automation.manual'}}</option>
        </select>
      </label>
    </div>
  </section>

  {{#if system.description}}
    <section class="tg-panel">
      <h2>{{localize 'TG.sheet.description'}}</h2>
      <textarea name="system.description">{{system.description}}</textarea>
    </section>
  {{/if}}
</form>
