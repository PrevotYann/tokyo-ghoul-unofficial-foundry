<section class="tg-system tg-chat-card">
  <h3>{{localize 'TG.chat.attack'}}</h3>
  <dl class="tg-chat-grid">
    <dt>{{localize 'TG.chat.attackRoll'}}</dt>
    <dd>{{roll.formula}} = <strong>{{roll.total}}</strong></dd>
    <dt>{{localize 'TG.chat.source'}}</dt>
    <dd>{{#if attack.itemName}}{{attack.itemName}}{{else}}{{localize 'TG.chat.basicAttack'}}{{/if}}</dd>
    <dt>{{localize 'TG.chat.targets'}}</dt>
    <dd>
      {{#each targets as |target|}}
        {{target.name}}{{#unless @last}}, {{/unless}}
      {{else}}
        {{localize 'TG.chat.noTargets'}}
      {{/each}}
    </dd>
    <dt>{{localize 'TG.chat.range'}}</dt>
    <dd>{{localize (concat "TG.ranges." rangeValidation.targetRangeBand)}} / {{localize (concat "TG.ranges." rangeValidation.maxRangeBand)}}</dd>
    <dt>{{localize 'TG.chat.damage'}}</dt>
    <dd>{{attack.damageFormula}} = <strong>{{attack.damage}}</strong></dd>
    <dt>{{localize 'TG.chat.staminaCost'}}</dt>
    <dd>{{attack.costFormula}} = <strong>{{attack.staminaCost}}</strong></dd>
    {{#if maneuverSpend.staminaPaid}}<dt>{{localize 'TG.chat.maneuverCost'}}</dt><dd>{{maneuverSpend.staminaPaid}}</dd>{{/if}}
    {{#if resourceSpend.vitalityCost}}
      <dt>{{localize 'TG.chat.vitalityOverflow'}}</dt>
      <dd>{{resourceSpend.vitalityCost}}</dd>
    {{/if}}
  </dl>
  {{#unless rangeValidation.valid}}
    <p class="tg-warning">{{localize rangeValidation.message}}</p>
  {{/unless}}
  <div class="tg-action-row">
    <button type="button" data-tg-chat-action="dodge">{{localize 'TG.actions.dodge'}}</button>
    <button type="button" data-tg-chat-action="block">{{localize 'TG.actions.block'}}</button>
    <button type="button" data-tg-chat-action="takeHit">{{localize 'TG.actions.takeHit'}}</button>
    {{#unless attack.grenade}}<button type="button" data-tg-chat-action="interpose">{{localize 'TG.actions.interpose'}}</button>{{/unless}}
  </div>
</section>
