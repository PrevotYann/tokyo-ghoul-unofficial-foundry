<div class="tg-system tg-form tg-builder-form" autocomplete="off">
  <section class="tg-panel">
    <h2>{{localize 'TG.builder.title'}}</h2>
    <div class="tg-grid tg-grid-2">
      <label>
        <span>{{localize 'TG.sheet.name'}}</span>
        <input name="name" type="text" value="{{localize 'TG.builder.defaultName'}}">
      </label>
      <label>
        <span>{{localize 'TG.sheet.class'}}</span>
        <select name="actorClass">
          <option value="ghoul">{{localize 'TG.classes.ghoul'}}</option>
          <option value="investigator">{{localize 'TG.classes.investigator'}}</option>
          <option value="quinx">{{localize 'TG.classes.quinx'}}</option>
        </select>
      </label>
      <label>
        <span>{{localize 'TG.builder.statPreset'}}</span>
        <select name="statPreset">
          {{#each presets as |preset|}}
            <option value="{{preset}}">{{localize (concat "TG.presets." preset)}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize 'TG.builder.kaguneType'}}</span>
        <select name="kaguneType">
          <option value="ukaku">{{localize 'TG.kagune.ukaku'}}</option>
          <option value="koukaku">{{localize 'TG.kagune.koukaku'}}</option>
          <option value="rinkaku">{{localize 'TG.kagune.rinkaku'}}</option>
          <option value="bikaku">{{localize 'TG.kagune.bikaku'}}</option>
        </select>
      </label>
      <label>
        <span>{{localize 'TG.builder.quinqueType'}}</span>
        <select name="quinqueType">
          <option value="ukaku">{{localize 'TG.kagune.ukaku'}}</option>
          <option value="koukaku">{{localize 'TG.kagune.koukaku'}}</option>
          <option value="rinkaku">{{localize 'TG.kagune.rinkaku'}}</option>
          <option value="bikaku">{{localize 'TG.kagune.bikaku'}}</option>
        </select>
      </label>
    </div>
  </section>
  <section class="tg-panel"><h2>{{localize 'TG.sheet.edges'}}</h2><div class="tg-grid tg-grid-2">
    <label><span>{{localize 'TG.builder.kaguneEdges'}}</span><select name="kaguneEdges" multiple size="6">{{#each kaguneEdges}}<option value="{{system.ruleId}}">{{name}} ({{system.slots}})</option>{{/each}}</select></label>
    <label><span>{{localize 'TG.builder.quinqueEdges'}}</span><select name="quinqueEdges" multiple size="6">{{#each quinqueEdges}}<option value="{{system.ruleId}}">{{name}} ({{system.slots}})</option>{{/each}}</select></label>
  </div><p class="tg-muted">{{localize 'TG.builder.edgeHint'}}</p></section>
  <section class="tg-panel"><h2>{{localize 'TG.builder.customStats'}}</h2><p class="tg-muted">{{localize 'TG.builder.customStatsHint'}}</p><div class="tg-grid tg-grid-3">{{#each stats}}<label><span>{{localize (concat "TG.stats." this ".label")}}</span><input name="stats.{{this}}" type="number" min="0" placeholder="10"></label>{{/each}}</div></section>
  <footer class="tg-action-row">
    <button type="submit">{{localize 'TG.builder.createActor'}}</button>
  </footer>
</div>
