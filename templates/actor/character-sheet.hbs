<div class="tg-form tg-character" autocomplete="off">
  <header class="tg-sheet-header">
    <img class="tg-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage">
    <div class="tg-header-main">
      <input class="tg-name" name="name" type="text" value="{{actor.name}}" aria-label="{{localize 'TG.sheet.name'}}">
      <div class="tg-chip-row">
        <span class="tg-chip">{{localize (concat "TG.classes." system.identity.class)}}</span>
        <span class="tg-chip">{{localize 'TG.resources.vitality.label'}} {{system.resources.vitality.value}} / {{system.resources.vitality.max}}</span>
        <span class="tg-chip">{{localize 'TG.resources.stamina.label'}} {{system.resources.stamina.value}} / {{system.resources.stamina.max}}</span>
        {{#if usesMealScore}}
          <span class="tg-chip">{{localize 'TG.resources.mealScore.label'}} {{system.resources.mealScore.value}} / {{system.resources.mealScore.max}}</span>
        {{/if}}
      </div>
      <div class="tg-action-row">
        <button type="button" data-actor-action="strike">{{localize 'TG.actions.strike'}}</button>
        <button type="button" data-actor-action="dodge">{{localize 'TG.actions.dodge'}}</button>
        <button type="button" data-actor-action="block">{{localize 'TG.actions.block'}}</button>
        <button type="button" data-actor-action="breather">{{localize 'TG.actions.breather'}}</button>
        <button type="button" data-actor-action="controlCheck">{{localize 'TG.actions.controlCheck'}}</button>
      </div>
    </div>
  </header>

  <nav class="tg-tabs" role="tablist" aria-label="{{localize 'TG.sheet.tabs'}}">
    <button type="button" class="active" role="tab" data-tg-tab="overview">{{localize 'TG.tabs.overview'}}</button>
    <button type="button" role="tab" data-tg-tab="combat">{{localize 'TG.tabs.combat'}}</button>
    <button type="button" role="tab" data-tg-tab="weapons">{{localize 'TG.tabs.weapons'}}</button>
    <button type="button" role="tab" data-tg-tab="edges">{{localize 'TG.tabs.edges'}}</button>
    <button type="button" role="tab" data-tg-tab="progression">{{localize 'TG.tabs.progression'}}</button>
    <button type="button" role="tab" data-tg-tab="inventory">{{localize 'TG.tabs.inventory'}}</button>
    <button type="button" role="tab" data-tg-tab="biography">{{localize 'TG.tabs.biography'}}</button>
    <button type="button" role="tab" data-tg-tab="settings">{{localize 'TG.tabs.settings'}}</button>
  </nav>

  <section role="tabpanel" data-tg-panel="overview">
    <div class="tg-panel">
      <h2>{{localize 'TG.sheet.identity'}}</h2>
      <div class="tg-grid tg-grid-4">
        <label>
          <span>{{localize 'TG.sheet.class'}}</span>
          <select name="system.identity.class">
            <option value="ghoul" {{#if (eq system.identity.class "ghoul")}}selected{{/if}}>{{localize 'TG.classes.ghoul'}}</option>
            <option value="investigator" {{#if (eq system.identity.class "investigator")}}selected{{/if}}>{{localize 'TG.classes.investigator'}}</option>
            <option value="quinx" {{#if (eq system.identity.class "quinx")}}selected{{/if}}>{{localize 'TG.classes.quinx'}}</option>
          </select>
        </label>
        <label>
          <span>{{localize 'TG.sheet.faction'}}</span>
          <input name="system.identity.faction" type="text" value="{{system.identity.faction}}">
        </label>
        <label>
          <span>{{localize 'TG.sheet.alias'}}</span>
          <input name="system.identity.alias" type="text" value="{{system.identity.alias}}">
        </label>
        <label>
          <span>{{localize 'TG.sheet.pronouns'}}</span>
          <input name="system.identity.pronouns" type="text" value="{{system.identity.pronouns}}">
        </label>
      </div>
      <div class="tg-action-row tg-panel-actions">
        <button type="button" data-actor-action="setupClass">{{localize 'TG.actions.setupClass'}}</button>
      </div>
    </div>

    <div class="tg-panel">
      <h2>{{localize 'TG.sheet.stats'}}</h2>
      <div class="tg-stat-grid">
        {{#each stats as |entry|}}
          <article class="tg-stat-card">
            <label>
              <span>{{localize (concat "TG.stats." entry.key ".label")}}</span>
              <input name="system.stats.{{entry.key}}.base" type="number" value="{{entry.data.base}}" min="0" step="1">
            </label>
            <div class="tg-stat-footer">
              <strong>{{entry.data.total}}</strong>
              <button type="button" data-roll-stat="{{entry.key}}">{{localize 'TG.actions.roll'}}</button>
            </div>
          </article>
        {{/each}}
      </div>
    </div>

    <div class="tg-panel">
      <h2>{{localize 'TG.sheet.resources'}}</h2>
      <div class="tg-action-row"><button type="button" data-actor-action="rage">{{localize 'TG.actions.rage'}}</button><button type="button" data-actor-action="assignStats">{{localize 'TG.actions.assignStats'}}</button>{{#if usesMealScore}}<button type="button" data-actor-action="feed">{{localize 'TG.actions.feed'}}</button>{{/if}}</div>
      <div class="tg-resource-grid">
        <label>
          <span>{{localize 'TG.resources.vitality.label'}}</span>
          <input name="system.resources.vitality.value" type="number" value="{{system.resources.vitality.value}}" min="0" step="1">
          <meter min="0" max="{{system.resources.vitality.max}}" value="{{system.resources.vitality.value}}"></meter>
        </label>
        <label>
          <span>{{localize 'TG.resources.stamina.label'}}</span>
          <input name="system.resources.stamina.value" type="number" value="{{system.resources.stamina.value}}" min="0" step="1">
          <meter min="0" max="{{system.resources.stamina.max}}" value="{{system.resources.stamina.value}}"></meter>
        </label>
        {{#if usesMealScore}}
          <label>
            <span>{{localize 'TG.resources.mealScore.label'}}</span>
            <input name="system.resources.mealScore.value" type="number" value="{{system.resources.mealScore.value}}" min="0" step="1">
            <meter min="0" max="{{system.resources.mealScore.max}}" value="{{system.resources.mealScore.value}}"></meter>
          </label>
        {{/if}}
      </div>
    </div>

    <div class="tg-panel">
      <h2>{{localize 'TG.sheet.validation'}}</h2>
      {{#if validation.warnings.length}}
        <ul class="tg-warning-list">
          {{#each validation.warnings as |warning|}}
            <li>{{localize warning.message}}</li>
          {{/each}}
        </ul>
      {{else}}
        <p class="tg-muted">{{localize 'TG.validation.noWarnings'}}</p>
      {{/if}}
    </div>
  </section>

  <section role="tabpanel" data-tg-panel="combat" hidden>
    <div class="tg-panel">
      <h2>{{localize 'TG.tabs.combat'}} <span class="tg-chip">{{system.resources.maneuverBudget.value}} / {{system.resources.maneuverBudget.max}} {{localize 'TG.sheet.maneuvers'}}</span></h2>
      <div class="tg-grid tg-grid-3">
        <label>
          <span>{{localize 'TG.sheet.combatMode'}}</span>
          <select name="system.combat.mode">
            <option value="squad" {{#if (eq system.combat.mode "squad")}}selected{{/if}}>{{localize 'TG.combat.squad'}}</option>
            <option value="raid" {{#if (eq system.combat.mode "raid")}}selected{{/if}}>{{localize 'TG.combat.raid'}}</option>
          </select>
        </label>
        <label>
          <span>{{localize 'TG.sheet.rangeBand'}}</span>
          <select name="system.combat.rangeBand">{{#each rangeBands}}<option value="{{this}}" {{#if (eq this ../system.combat.rangeBand)}}selected{{/if}}>{{localize (concat "TG.ranges." this)}}</option>{{/each}}</select>
        </label>
        <label>
          <span>{{localize 'TG.sheet.reactionsReserved'}}</span>
          <input name="system.resources.maneuverBudget.reactionsReserved" type="number" value="{{system.resources.maneuverBudget.reactionsReserved}}" min="0" step="1">
        </label>
      </div>
      <div class="tg-action-row tg-panel-actions">
        <button type="button" data-actor-action="reserveReaction">{{localize 'TG.actions.reserveReaction'}}</button>
        {{#each maneuverActions}}<button type="button" data-actor-action="{{this}}">{{localize (concat "TG.actions." this)}}</button>{{/each}}
        <button type="button" data-actor-action="toggleGimmick">{{localize 'TG.actions.toggleGimmick'}}</button>
      </div>
    </div>
    {{> "systems/tokyo-ghoul-unofficial/templates/actor/parts/item-list.hbs" group=(lookup itemGroups 2)}}
  </section>

  <section role="tabpanel" data-tg-panel="weapons" hidden>
    {{> "systems/tokyo-ghoul-unofficial/templates/actor/parts/item-list.hbs" group=(lookup itemGroups 0)}}
  </section>

  <section role="tabpanel" data-tg-panel="edges" hidden>
    {{> "systems/tokyo-ghoul-unofficial/templates/actor/parts/item-list.hbs" group=(lookup itemGroups 1)}}
  </section>

  <section role="tabpanel" data-tg-panel="progression" hidden>
    <div class="tg-panel">
      <h2>{{localize 'TG.tabs.progression'}}</h2>
      <div class="tg-grid tg-grid-2">
        <label>
          <span>{{localize 'TG.sheet.statPoints'}}</span>
          <input name="system.progression.statPoints" type="number" value="{{system.progression.statPoints}}" min="0" step="1">
        </label>
        <label>
          <span>{{localize 'TG.sheet.kakujaStage'}}</span>
          <select name="system.kakuja.stage">{{#each kakujaStages}}<option value="{{this}}" {{#if (eq this ../system.kakuja.stage)}}selected{{/if}}>{{localize (concat "TG.kakuja." this)}}</option>{{/each}}</select>
        </label>
      </div>
      <div class="tg-grid tg-grid-3">
        <label class="tg-inline-check"><span>{{localize 'TG.sheet.kakujaUnlocked'}}</span><input name="system.kakuja.eligible" type="checkbox" {{#if system.kakuja.eligible}}checked{{/if}}></label>
        <label class="tg-inline-check"><span>{{localize 'TG.sheet.masteredHalf'}}</span><input name="system.kakuja.masteredHalf" type="checkbox" {{#if system.kakuja.masteredHalf}}checked{{/if}}></label>
        <label class="tg-inline-check"><span>{{localize 'TG.sheet.masteredFull'}}</span><input name="system.kakuja.masteredFull" type="checkbox" {{#if system.kakuja.masteredFull}}checked{{/if}}></label>
      </div>
      <p class="tg-muted">{{localize 'TG.sheet.masteryProgress'}}: {{system.kakuja.masterySuccesses}} ? {{system.kakuja.selectedBonus}}</p>
      <div class="tg-action-row tg-panel-actions">
        <button type="button" data-actor-action="mastery">{{localize 'TG.actions.mastery'}}</button>
        <button type="button" data-actor-action="consume">{{localize 'TG.actions.consume'}}</button>
        <button type="button" data-actor-action="spendPoints">{{localize 'TG.actions.spendPoints'}}</button>
        <button type="button" data-actor-action="evolve">{{localize 'TG.actions.evolve'}}</button>
        <button type="button" data-actor-action="forge">{{localize 'TG.actions.forge'}}</button>
        <button type="button" data-actor-action="upgrade">{{localize 'TG.actions.upgrade'}}</button>
        <button type="button" data-actor-action="activateKakuja">{{localize 'TG.actions.activateKakuja'}}</button>
        <button type="button" data-actor-action="deactivateKakuja">{{localize 'TG.actions.deactivateKakuja'}}</button>
      </div>
      <div class="tg-rich-field">
        <span>{{localize 'TG.sheet.notes'}}</span>
        <prose-mirror class="tg-rich-text" name="system.progression.notes" data-document-uuid="{{actor.uuid}}" value="{{system.progression.notes}}" toggled {{#unless isEditable}}disabled{{/unless}}>{{{lookup enriched "progression.notes"}}}</prose-mirror>
      </div>
    </div>
  </section>

  <section role="tabpanel" data-tg-panel="inventory" hidden>
    {{> "systems/tokyo-ghoul-unofficial/templates/actor/parts/item-list.hbs" group=(lookup itemGroups 3)}}
    {{> "systems/tokyo-ghoul-unofficial/templates/actor/parts/item-list.hbs" group=(lookup itemGroups 4)}}
  </section>

  <section role="tabpanel" data-tg-panel="biography" hidden>
    <div class="tg-panel">
      <h2>{{localize 'TG.tabs.biography'}}</h2>
      <div class="tg-grid tg-grid-2">
        <div class="tg-rich-field">
          <span>{{localize 'TG.biography.appearance'}}</span>
          <prose-mirror class="tg-rich-text" name="system.biography.appearance" data-document-uuid="{{actor.uuid}}" value="{{system.biography.appearance}}" toggled {{#unless isEditable}}disabled{{/unless}}>{{{lookup enriched "biography.appearance"}}}</prose-mirror>
        </div>
        <div class="tg-rich-field">
          <span>{{localize 'TG.biography.personality'}}</span>
          <prose-mirror class="tg-rich-text" name="system.biography.personality" data-document-uuid="{{actor.uuid}}" value="{{system.biography.personality}}" toggled {{#unless isEditable}}disabled{{/unless}}>{{{lookup enriched "biography.personality"}}}</prose-mirror>
        </div>
        <div class="tg-rich-field">
          <span>{{localize 'TG.biography.backstory'}}</span>
          <prose-mirror class="tg-rich-text" name="system.biography.backstory" data-document-uuid="{{actor.uuid}}" value="{{system.biography.backstory}}" toggled {{#unless isEditable}}disabled{{/unless}}>{{{lookup enriched "biography.backstory"}}}</prose-mirror>
        </div>
        <div class="tg-rich-field">
          <span>{{localize 'TG.biography.goals'}}</span>
          <prose-mirror class="tg-rich-text" name="system.biography.goals" data-document-uuid="{{actor.uuid}}" value="{{system.biography.goals}}" toggled {{#unless isEditable}}disabled{{/unless}}>{{{lookup enriched "biography.goals"}}}</prose-mirror>
        </div>
      </div>
    </div>
  </section>

  <section role="tabpanel" data-tg-panel="settings" hidden>
    <div class="tg-panel">
      <h2>{{localize 'TG.tabs.settings'}}</h2>
      <div class="tg-rich-field">
        <span>{{localize 'TG.sheet.ruleNotes'}}</span>
        <prose-mirror class="tg-rich-text" name="system.automation.ruleNotes" data-document-uuid="{{actor.uuid}}" value="{{system.automation.ruleNotes}}" toggled {{#unless isEditable}}disabled{{/unless}}>{{{lookup enriched "automation.ruleNotes"}}}</prose-mirror>
      </div>
    </div>
    <div class="tg-panel"><h2>{{localize 'TG.sheet.effects'}}</h2>
      <button type="button" data-actor-action="addEffect">{{localize 'TG.actions.addEffect'}}</button>
      <ol class="tg-item-list">{{#each effects}}<li><button type="button" data-effect-id="{{id}}">{{name}}</button><span class="tg-chip">{{#if disabled}}{{localize 'TG.states.inactive'}}{{else}}{{localize 'TG.states.active'}}{{/if}}</span></li>{{/each}}</ol>
    </div>
  </section>
</div>
